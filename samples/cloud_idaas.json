{
  "clientId": "your-client-id",
  "idaasInstanceId": "your-idaas-instance-id",
  "issuer": "https://your-idaas-instance.aliyunidaas.com/api/v2/<authorizationServerId>/oauth2",
  "tokenEndpoint": "https://your-idaas-instance.aliyunidaas.com/api/v2/<authorizationServerId>/oauth2/token",
  "scope": "urn:cloud:idaas:pam|cloud_account_role:obtain_access_credential",
  "developerApiEndpoint": "eiam-developerapi.cn-hangzhou.aliyuncs.com",
  "authnConfiguration": {
    "identityType": "CLIENT",
    "authnMethod": "CLIENT_SECRET_BASIC",
    "clientSecretEnvVarName": "IDAAS_CLIENT_SECRET"
  },
  "httpConfiguration": {
    "connectTimeout": 5000,
    "readTimeout": 10000
  }
}
